{
  "name": "@barndoor-ai/sdk",
  "version": "2.0.0",
  "description": "TypeScript client for the Barndoor Platform API",
  "author": "Barndoor AI, Inc. (https://barndoor.ai)",
  "homepage": "https://barndoor.ai",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/barndoor-ai/bdai-platform.git"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/lib/cli.d.ts",
      "import": "./dist/esm/lib/cli.js",
      "require": "./dist/lib/cli.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', '{\\\"type\\\":\\\"module\\\"}')\"",
    "prepare": "npm run build",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "openid-client": "^6.8.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^4.0 || ^5.0"
  }
}
